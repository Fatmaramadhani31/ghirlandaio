[0.017, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[?1h\u001b=\u001b[H\u001b[2J\u001b]11;?\u0007\u001b[?2004h\u001b[?u\u001b[c\u001b[?25h"]
[0.091, "o", "\u001b[?25l\u001b(B\u001b[m\u001b[H\u001b[2J\u001b[>1u\u001b[?1004h\u001b[?25h"]
[0.381, "o", "\u001b[?25l\u001b[96m# For more information on this configuration file, see containers-registries.conf(5).\u001b(B\u001b[m\u001b[K\r\n\u001b[96m#\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# NOTE: RISK OF USING UNQUALIFIED IMAGE NAMES\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# We recommend always using fully qualified image names including the registry\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# server (full dns name), namespace, image name, and tag\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# (e.g., registry.redhat.io/ubi8/ubi:latest). Pulling by digest (i.e.,\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# quay.io/repository/name@digest) further eliminates the ambiguity of tags.\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# When using short names, there is always an inherent risk that the image being\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# pulled could be spoofed. For example, a user wants to pull an image named\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# `foobar` from a registry and expects it to come from myregistry.com. If\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# myregistry.com is not first in the search list, an attacker could place a\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# different `foobar` image at a registry earlier in the search list. The user\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# would accidentally pull and run the attacker's image and code rather than the\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# intended content. We recommend only adding registries which are completely\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# trusted (i.e., registries which don't allow unknown or anonymous users to\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# create accounts with arbitrary names). This will prevent an image from being\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# spoofed, squatted or otherwise made insecure.  If it is necessary to use one\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# of these registries, it should be added at the end of the list.\u001b(B\u001b[m\u001b[K\r\n\u001b[96m#\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # An array of host[:port] registries to try when pulling an unqualified image, in order.\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# unqualified-search-registries = [\"example.com\"]\u001b(B\u001b[m\u001b[K\r\n\u001b[96m#\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# [[registry]]\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # The \"prefix\" field is used to choose the relevant [[registry]] TOML table;\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # (only) the TOML table with the longest match for the input image name\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # (taking into account namespace/repo/tag/digest separators) is used.\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# #\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # The prefix can also be of the form: *.example.com for wildcard subdomain\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # matching.\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# #\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # If the prefix field is missing, it defaults to be the same as the \"location\" field.\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# prefix = \"example.com/foo\"\u001b(B\u001b[m\u001b[K\r\n\u001b[96m#\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # If true, unencrypted HTTP as well as TLS connections with untrusted\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # certificates are allowed.\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# insecure = false\u001b(B\u001b[m\u001b[K\r\n\u001b[96m#\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # If true, pulling images with matching names is forbidden.\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# blocked = false\u001b(B\u001b[m\u001b[K\r\n\u001b[96m#\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# # The physical location of the \"prefix\"-rooted namespace.\u001b(B\u001b[m\u001b[K\r\n\u001b[96m# #\u001b(B\u001b[m\u001b[K\r\n\u001b(B\u001b[0;1;7m/etc/containers/registries.conf [RO]                                       1,1            Top\u001b]112\u0007\u001b[2 q\u001b]112\u0007\u001b[2 q\u001b[?1002h\u001b[?1006h\u001b[H\u001b[?25h"]
