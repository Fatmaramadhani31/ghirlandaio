[0.002, "o", "  File \u001b[35m\"/usr/bin/podman-compose\"\u001b[0m, line \u001b[35m8\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n    sys.exit(\u001b[31mmain\u001b[0m\u001b[1;31m()\u001b[0m)\r\n             \u001b[31m~~~~\u001b[0m\u001b[1;31m^^\u001b[0m\r\n  File \u001b[35m\"/usr/lib/python3.14/site-packages/podman_compose.py\"\u001b[0m, line \u001b[35m4970\u001b[0m, in \u001b[35mmain\u001b[0m\r\n    \u001b[31masyncio.run\u001b[0m\u001b[1;31m(async_main())\u001b[0m\r\n    \u001b[31m~~~~~~~~~~~\u001b[0m\u001b[1;31m^^^^^^^^^^^^^^\u001b[0m\r\n  File \u001b[35m\"/usr/lib/python3.14/asyncio/runners.py\"\u001b[0m, line \u001b[35m204\u001b[0m, in \u001b[35mrun\u001b[0m\r\n    return \u001b[31mrunner.run\u001b[0m\u001b[1;31m(main)\u001b[0m\r\n           \u001b[31m~~~~~~~~~~\u001b[0m\u001b[1;31m^^^^^^\u001b[0m\r\n  File \u001b[35m\"/usr/lib/python3.14/asyncio/runners.py\"\u001b[0m, line \u001b[35m127\u001b[0m, in \u001b[35mrun\u001b[0m\r\n    return \u001b[31mself._loop.run_until_complete\u001b[0m\u001b[1;31m(task)\u001b[0m\r\n           \u001b[31m~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\u001b[0m\u001b[1;31m^^^^^^\u001b[0m\r\n"]
[0.000, "o", "  File \u001b[35m\"/usr/lib/python3.14/asyncio/base_events.py\"\u001b[0m, line \u001b[35m719\u001b[0m, in \u001b[35mrun_until_complete\u001b[0m\r\n    return \u001b[31mfuture.result\u001b[0m\u001b[1;31m()\u001b[0m\r\n           \u001b[31m~~~~~~~~~~~~~\u001b[0m\u001b[1;31m^^\u001b[0m\r\n  File \u001b[35m\"/usr/lib/python3.14/site-packages/podman_compose.py\"\u001b[0m, line \u001b[35m4965\u001b[0m, in \u001b[35masync_main\u001b[0m\r\n    await podman_compose.run()\r\n  File \u001b[35m\"/usr/lib/python3.14/site-packages/podman_compose.py\"\u001b[0m, line \u001b[35m2373\u001b[0m, in \u001b[35mrun\u001b[0m\r\n    retcode = \u001b[1;31mawait cmd(self, args)\u001b[0m\r\n              \u001b[1;31m^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n  File \u001b[35m\"/usr/lib/python3.14/site-packages/podman_compose.py\"\u001b[0m, line \u001b[35m3810\u001b[0m, in \u001b[35mcompose_up\u001b[0m\r\n    podman_args = \u001b[1;31mawait container_to_args(compose, cnt, detached=False, no_deps=args.no_deps)\u001b[0m\r\n                  \u001b[1;31m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n"]
[0.000, "o", "  File \u001b[35m\"/usr/lib/python3.14/site-packages/podman_compose.py\"\u001b[0m, line \u001b[35m1384\u001b[0m, in \u001b[35mcontainer_to_args\u001b[0m\r\n    podman_args.extend(\u001b[31mget_net_args\u001b[0m\u001b[1;31m(compose, cnt)\u001b[0m)\r\n                       \u001b[31m~~~~~~~~~~~~\u001b[0m\u001b[1;31m^^^^^^^^^^^^^^\u001b[0m\r\n  File \u001b[35m\"/usr/lib/python3.14/site-packages/podman_compose.py\"\u001b[0m, line \u001b[35m1207\u001b[0m, in \u001b[35mget_net_args\u001b[0m\r\n    return get_net_args_from_networks(compose, cnt)\r\n  File \u001b[35m\"/usr/lib/python3.14/site-packages/podman_compose.py\"\u001b[0m, line \u001b[35m1237\u001b[0m, in \u001b[35mget_net_args_from_networks\u001b[0m\r\n    multiple_nets = {net: net_config or {} for net, net_config in \u001b[1;31mmultiple_nets.items\u001b[0m()}\r\n                                                                  \u001b[1;31m^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n"]
