[0.032, "o", "\u001b[?25l\u001b(B\u001b[m\u001b[H                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                     \r\n                                             